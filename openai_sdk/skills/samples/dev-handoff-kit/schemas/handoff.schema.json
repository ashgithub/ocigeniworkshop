{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Developer handoff",
  "type": "object",
  "required": ["title", "purpose", "audience", "change_summary", "files", "run_steps", "verification"],
  "properties": {
    "title": {"type": "string"},
    "purpose": {"type": "string"},
    "audience": {"type": "string"},
    "change_summary": {"type": "string"},
    "files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "run_steps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verification": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "follow_up": {"type": "string"}
  },
  "additionalProperties": false
}
